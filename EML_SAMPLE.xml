year. Column list taken from scripts/TCRMPcvr_makeAllPoints/run.py
(line 564). Approx 2.3M rows / 82 MB.
</entityDescription>
      <physical>
        <objectName>reef_point_seg_all_points.csv</objectName>
        <dataFormat>
          <textFormat>
            <numHeaderLines>1</numHeaderLines>
            <recordDelimiter>\n</recordDelimiter>
            <simpleDelimited>
              <fieldDelimiter>,</fieldDelimiter>
            </simpleDelimited>
          </textFormat>
        </dataFormat>
      </physical>
      <attributeList>
        <attribute>
          <attributeName>date</attributeName>
          <attributeDefinition>Survey date parsed from the source CVR workbook.</attributeDefinition>
          <measurementScale>
            <dateTime>
              <formatString>YYYY-MM-DD</formatString>
            </dateTime>
          </measurementScale>
        </attribute>
        <attribute>
          <attributeName>year</attributeName>
          <attributeDefinition>Year component of date, convenience column for filtering.</attributeDefinition>
          <measurementScale>
            <ratio>
              <unit>
                <customUnit>dimensionless</customUnit>
              </unit>
              <numericDomain>
                <numberType>integer</numberType>
              </numericDomain>
            </ratio>
          </measurementScale>
        </attribute>
        <attribute>
          <attributeName>site</attributeName>
          <attributeDefinition>TCRMP site code (3-letter short code).</attributeDefinition>
          <measurementScale>
            <nominal>
              <nonNumericDomain>
                <textDomain>
                  <definition>TCRMP site code (3-letter short code).</definition>
                </textDomain>
              </nonNumericDomain>
            </nominal>
          </measurementScale>
        </attribute>
        <attribute>
          <attributeName>transect</attributeName>
          <attributeDefinition>Transect number within the site (1-6).</attributeDefinition>
          <measurementScale>
            <ratio>
              <unit>
                <customUnit>dimensionless</customUnit>
              </unit>
              <numericDomain>
                <numberType>integer</numberType>
              </numericDomain>
            </ratio>
          </measurementScale>
        </attribute>
        <attribute>
          <attributeName>frame</attributeName>
          <attributeDefinition>Video frame index sampled for the point.</attributeDefinition>
          <measurementScale>
            <ratio>
              <unit>
                <customUnit>dimensionless</customUnit>
              </unit>
              <numericDomain>
                <numberType>integer</numberType>
              </numericDomain>
            </ratio>
          </measurementScale>
        </attribute>
        <attribute>
          <attributeName>point_label</attributeName>
          <attributeDefinition>CPC point label (per-frame annotation identifier).</attributeDefinition>
